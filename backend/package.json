{
  "name": "sru-timetable-backend",
  "version": "1.0.0",
  "description": "Backend for SRU Timetable App",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync": "ts-node src/sync/index.ts",
    "test:adapter": "ts-node src/sru/test-adapter.ts",
    "test:rls": "ts-node src/db/verify-rls.ts",
    "test:changes": "ts-node src/sync/test-change-detection.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.0",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
